# ─── Discord ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# Your server (guild) ID. Right-click server icon → Copy Server ID (needs
# Developer Mode on). Used for instant slash-command registration.
# Leave blank to register globally (takes up to 1 hour to appear).
GUILD_ID=

# Channel where launch + trade alerts are posted.
# Right-click channel → Copy Channel ID.
ALERT_CHANNEL_ID=

# ─── Chain ──────────────────────────────────────────────────────────────────
# Alchemy key for Elysium mainnet. Used for the live WebSocket subscription
# and for eth_call reads.
ALCHEMY_KEY=

# Public RPC. Used for wide eth_getLogs backfill, because Alchemy's free tier
# caps getLogs at a 10-block range.
PUBLIC_RPC_URL=https://rpc.elysium.kinetiq.xyz

# ─── Behaviour ──────────────────────────────────────────────────────────────
# Where to start indexing on a cold start. Ascend's deployment block.
START_BLOCK=422319

# Minimum trade size to alert on, in the pool's quote asset units.
# Per-asset defaults live in src/constants.js; this overrides the default.
# Example: MIN_TRADE_QUOTE=1.5
MIN_TRADE_QUOTE=

# Minimum seconds between trade alerts for the same pool (anti-spam).
POOL_COOLDOWN_SECONDS=8

# Max trade alerts posted per minute across all pools.
MAX_ALERTS_PER_MINUTE=20

# Post launch alerts. Set to false to only post trades.
ALERT_LAUNCHES=true

# Post trade alerts. Set to false to only post launches.
ALERT_TRADES=true

# ─── Optional ───────────────────────────────────────────────────────────────
# IPFS gateway used to render coin art in embeds.
IPFS_GATEWAY=https://ipfs.io/ipfs/

# Block explorer base, used for tx links.
EXPLORER_URL=https://elysium.kinetiq.xyz/explorer

# ─── Quick-buy buttons ──────────────────────────────────────────────────────
# Every launch alert carries a "Buy on Ascend" link built from these two.
# If Ascend changes their per-token route, change ASCEND_TOKEN_PATH — no code
# change needed.
ASCEND_APP_URL=https://app.ascendlaunch.xyz
ASCEND_TOKEN_PATH=/token/

# Optional trading-partner button. Leave blank to hide it. {ca} is replaced
# with the token contract address. Only set this to a route you have actually
# verified — a dead buy button is worse than no button.
# FOMO_URL_TEMPLATE=https://fomo.biz/token/{ca}

# SQLite file path.
DB_PATH=./data/ascend.db

# Log level: debug | info | warn | error
LOG_LEVEL=info
